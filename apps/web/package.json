  },
  "dependencies": {
    "@protomaps/basemaps": "5.7.2",
    "@radix-ui/react-label": "2.1.15",
    "@radix-ui/react-slot": "1.3.3",
    "@tailwindcss/postcss": "4.3.3",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.47.0",
    "maplibre-gl": "5.24.0",
    "next": "15.2.4",
    "pmtiles": "4.5.0",
    "react": "19.0.0",
    "react-dom": "19.0.0",
    "tailwind-merge": "3.7.0",
    "tailwindcss": "4.3.3"
  },
  "devDependencies": {
    "@eslint/js": "9.23.0",
    "@types/jest": "29.5.14",
    "@types/node": "22.13.14",
    "@types/react": "19.0.12",
    "@types/react-dom": "19.0.4",
    "eslint": "9.23.0",
    "jest": "29.7.0",
    "ts-jest": "29.3.0",
