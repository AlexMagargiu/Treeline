{$TREELINE_HOST} {
	# Not the tile files. A PMTiles archive holds gzipped tiles already, so compressing it
	# again buys nothing, and a compressed response cannot carry a byte range, which is the
	# one thing the whole PMTiles design needs.
	@compressible not path /tiles/*
	encode @compressible

	header {
		X-Content-Type-Options nosniff
		Referrer-Policy strict-origin-when-cross-origin
	}

	# Tiles are served straight from disk, without a session. They are OpenStreetMap and
	# Copernicus data, they contain nothing personal, and putting them behind the Next.js
	# gate would mean proxying every range request through Next for no benefit. This is
	# deliberate. See infra/tiles/README.md.
	handle_path /tiles/* {
		root * /srv/tiles
		# A tile file is immutable until it is rebuilt, and the name carries no hash, so a
		# rebuild needs a cache-busting change. See infra/tiles/README.md.
		header Cache-Control "public, max-age=31536000, immutable"
		file_server
	}

	# The API keeps its /api prefix, so the same path works with and without Caddy.
	handle /api/* {
		reverse_proxy api:3001
	}

	handle {
		reverse_proxy web:3000
	}
}
