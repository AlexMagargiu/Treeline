# Copy to .env and fill in. .env is never committed.

# The site address Caddy serves. "localhost" locally, where Caddy issues its own
# certificate. On the box it is 89-167-90-189.sslip.io.
TREELINE_HOST=localhost

# Which image tag the box pulls. "latest" normally, a commit SHA to roll back.
IMAGE_TAG=latest

POSTGRES_USER=treeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=treeline

# The host's view of the same database, used by the prisma CLI and prisma studio, which
# run outside Compose and reach the port docker-compose.override.yml publishes on the
# loopback. The containers build their own URL from the three variables above and never
# read this one. Keep the password free of characters a URL reserves, because it is
# interpolated into both strings.
DATABASE_URL=postgresql://treeline:change-me@localhost:55432/treeline

# The one user, until there is a user table. The column default on profile.owner_id and
# saved_filter.owner_id is this same uuid.
SEED_OWNER_ID=00000000-0000-0000-0000-000000000001

REDIS_URL=redis://redis:6379

# The host's view of the same Redis, used by the end-to-end suite, which runs outside
# Compose the same way the prisma CLI does. The containers read REDIS_URL above and never
# read this one. Set it to whatever loopback port docker-compose.override.yml publishes.
REDIS_URL_HOST=redis://127.0.0.1:56379

# The one shared password, as an argon2id hash. docs/deploy.md has the command that
# generates it. The plain password is never stored anywhere.
# KEEP THE SINGLE QUOTES. Compose interpolates $ in a .env value, so an unquoted hash
# is read as the variables $argon2id, $v and $m, each replaced with an empty string,
# and every login then fails against a mangled hash with nothing in the logs to say why.
TREELINE_PASSWORD_HASH='$argon2id$v=19$m=19456,t=2,p=1$REPLACE-THIS-WITH-YOUR-OWN-HASH'

# The session cookie and how long it lasts. The cookie carries a session id and nothing
# else; Redis holds the session for the same period.
SESSION_COOKIE_NAME=treeline_session
SESSION_TTL_DAYS=30

# Login attempts per IP per window, counted in Redis. Failures and successes alike.
LOGIN_MAX_ATTEMPTS=5
LOGIN_WINDOW_MINUTES=15

MINIO_ROOT_USER=treeline
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://storage:9000
S3_BUCKET=treeline-photos

# Dumps older than this many days are deleted from the backups volume.
BACKUP_RETENTION_DAYS=14
