# Copy to .env and fill in. .env is never committed.

# The site address Caddy serves. "localhost" locally, where Caddy issues its own
# certificate. On the box it is 89-167-90-189.sslip.io.
TREELINE_HOST=localhost

# Which image tag the box pulls. "latest" normally, a commit SHA to roll back.
IMAGE_TAG=latest

POSTGRES_USER=treeline
POSTGRES_PASSWORD=change-me
POSTGRES_DB=treeline

# The host's view of the same database, used by the prisma CLI and prisma studio, which
# run outside Compose and reach the port docker-compose.override.yml publishes on the
# loopback. The containers build their own URL from the three variables above and never
# read this one. Keep the password free of characters a URL reserves, because it is
# interpolated into both strings.
DATABASE_URL=postgresql://treeline:change-me@localhost:55432/treeline

# The one user, until there is a user table. The column default on profile.owner_id and
# saved_filter.owner_id is this same uuid.
SEED_OWNER_ID=00000000-0000-0000-0000-000000000001

REDIS_URL=redis://redis:6379

MINIO_ROOT_USER=treeline
MINIO_ROOT_PASSWORD=change-me-too
S3_ENDPOINT=http://storage:9000
S3_BUCKET=treeline-photos

# Dumps older than this many days are deleted from the backups volume.
BACKUP_RETENTION_DAYS=14
